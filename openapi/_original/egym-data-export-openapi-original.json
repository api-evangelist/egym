        "operationId": "getCardioMeasurements",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromTimestamp",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
