    {
      "info": {
        "name": "Flexibility Measurement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Flexibility Measurement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://partner-api.ext-1.test.co.egym.coffee/api/v1/measurements/flexibility",
            "params": [
              {
                "name": "metrics",
                "value": "",
                "type": "query",
                "description": "Subset of FlexibilityMetricType values to include in the response. When omitted, all available metric types are returned."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint retrieves the latest flexibility measurement of the user"
        },
        {
          "info": {
            "name": "Create Flexibility Measurement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://partner-api.ext-1.test.co.egym.coffee/api/v1/measurements/flexibility",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint creates a Flexibility measurement for the user"
        },
        {
          "info": {
            "name": "Get Flexibility History for a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://partner-api.ext-1.test.co.egym.coffee/api/v1/measurements/flexibility/history",
            "params": [
              {
                "name": "lastId",
                "value": "",
                "type": "query",
                "description": "Cursor for keyset pagination. When provided, only measurements with an ID strictly less than this value are returned, allowing the client to page backwards through the history. Omit on the first request."
              },
              {
                "name": "measurementLimit",
                "value": "",
                "type": "query",
                "description": "Maximum number of measurements to return. Must be a positive integer. When omitted, the server applies its default limit."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint retrieves flexibility measurements history for the user with pagination support"
        }
      ]
    },
