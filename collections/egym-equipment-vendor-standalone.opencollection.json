{
  "opencollection": "1.0.0",
  "info": {
    "name": "Equipment Vendor API (for standalone clients)",
    "version": "1.2.0"
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "User Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://partner-api.ext-1.test.co.egym.coffee/api/v1/users",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint returns a user"
        },
        {
          "info": {
            "name": "User Details",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://partner-api.ext-1.test.co.egym.coffee/api/v1/users",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint updates the current user. The endpoint is only enabled if there is a specific use case to update user records."
        },
        {
          "info": {
            "name": "Accept Terms and Conditions",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://partner-api.ext-1.test.co.egym.coffee/api/v1/users/terms-and-conditions",
            "params": [
              {
                "name": "locale",
                "value": "en_US",
                "type": "query",
                "description": "Defines the locale in ISO 15897 standard format."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint when invoked will save the information that the user accepted the eGym Terms and Conditions."
        },
        {
          "info": {
            "name": "Set user's avatar",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://partner-api.ext-1.test.co.egym.coffee/api/v1/users/image",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint sets the user's avatar."
        },
        {
          "info": {
            "name": "Assign RFID",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://partner-api.ext-1.test.co.egym.coffee/api/v1/users/rfid",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint assigns one RFID to the user. If the RFID is already assigned to another user, it will be re-assigned to this user."
        }
      ]
    },
